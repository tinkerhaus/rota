engine-strict=false
# pnpm 11 runs a deps-status check (an implicit `pnpm install`) before `pnpm run`
# scripts; that check exits non-zero purely because esbuild's build script is
# gated, which would fail `pnpm build`. esbuild's native binary is already
# present, so the script is not needed at runtime — skip the pre-run check.
verify-deps-before-run=false
